<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gift_Date_Not_In_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Gift_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Gift_Date__c</errorDisplayField>
    <errorMessage>Gift date cannot be in the future.</errorMessage>
</ValidationRule>
